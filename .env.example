# Agent Studio — required environment variables
# Copy this file to .env and fill in your values

# OpenAI API key (required)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# OpenAI model to use (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# GitHub token for gh CLI (optional, only needed for PR features)
# gh CLI auth (gh auth login) is the primary auth method
GITHUB_TOKEN=your-token-here
